# Public Supabase client config (safe in browser — RLS protects data)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Demo mode: set to "true" to use local demo auth without a Supabase project.
# When true (or when URL/key are missing), the app shows a clear «Демо-режим» banner.
VITE_DEMO_AUTH=true

# --- AI / examiners (Stage 6) ---
# Spend lock ON by default. Local rule-based examiners always work.
# Set VITE_AI_SPEND_LOCK=false AND VITE_AI_LIVE_UNLOCK=true only if you intentionally
# enable live proxy later. Provider API keys must NEVER be VITE_* (server secrets only).
VITE_AI_SPEND_LOCK=true
# VITE_AI_LIVE_UNLOCK=false
# VITE_AI_LIVE_CONFIGURED=false
#
# Honest free-quota note (when you add a server proxy later):
# - Prefer a provider with a free credit/quota tier; quotas end — UI must fall back to local examiner.
# - Example server-only secrets (NOT for Vite client):
#   AI_PROVIDER_API_KEY=...
#   AI_MONTHLY_TOKEN_BUDGET=0

# --- Server / bootstrap only (NEVER put these in VITE_* or client code) ---
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_DB_URL=postgresql://postgres:...@db.YOUR_PROJECT.supabase.co:5432/postgres
