# Public Supabase client config (safe in browser — RLS protects data)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Demo mode: set to "true" to use local demo auth without a Supabase project.
# When true (or when URL/key are missing), the app shows a clear «Демо-режим» banner.
VITE_DEMO_AUTH=true

# --- AI / examiners ---
# Spend lock ON by default = block paid provider paths.
# Local examiners always work (fast gate / claim-vs-sources).
VITE_AI_SPEND_LOCK=true
# VITE_AI_LIVE_UNLOCK=false

# Public UI flags only (NO provider secrets here):
# After you add free-tier keys on Vercel server env, set both to true and redeploy.
VITE_AI_LIVE_CONFIGURED=false
VITE_AI_EXPERT_ENABLED=false

# --- Server only (Vercel Environment Variables, NEVER VITE_*, never commit) ---
# Free-tier expert proxy: api/expert-exam.mjs  (Gemini → Groq → OpenRouter failover)
# AI_EXPERT_ENABLED=true
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# AI_MONTHLY_REQUEST_CAP=120
# AI_MONTHLY_TOKEN_BUDGET=400000
# Hard kill-switch for all expert calls: AI_SPEND_LOCK=force
#
# Optional metering via Supabase ai_usage (service role — server only):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Bootstrap only (NEVER put these in VITE_* or client code) ---
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_DB_URL=postgresql://postgres:...@db.YOUR_PROJECT.supabase.co:5432/postgres
